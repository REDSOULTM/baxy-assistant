      "weight": 1,
      "message": "Hola BAXY, ¿cómo estás?",
      "expected": {"state": "done", "intent": "conversation", "effect": "none", "verification": "not_applicable", "filesystem_changes": 0}
    },
    {
      "id": "T02_CREATE_NOTE",
      "weight": 2,
      "message": "Crea la nota ideas.txt con el texto: comprar té",
      "expected": {"state": "done", "intent": "note.create", "effect": "reversible", "verification": "verified", "file": "notes/ideas.txt", "content": "comprar té"}
    },
    {
      "id": "T03_READ_NOTE",
      "weight": 1,
      "message": "Lee la nota ideas.txt",
      "expected": {"state": "done", "intent": "note.read", "effect": "read_only", "verification": "verified", "response_contains": "comprar té"}
    },
    {
      "id": "T04_COMPOUND_CREATE_READ",
      "weight": 2,
      "message": "Crea la nota plan.txt con el texto: fase uno y después léela",
      "expected": {"state": "done", "intent": "note.create_and_read", "effect": "reversible", "verification": "verified", "operations": 2, "response_contains": "fase uno"}
    },
    {
      "id": "T05_TRASH_NOTE",
      "weight": 2,
      "message": "Mueve la nota ideas.txt a la papelera",
      "expected": {"state": "done", "intent": "note.trash", "effect": "reversible", "verification": "verified", "absent": "notes/ideas.txt", "present": "trash/ideas.txt"}
    },
    {
      "id": "T06_RESTORE_NOTE",
      "weight": 2,
