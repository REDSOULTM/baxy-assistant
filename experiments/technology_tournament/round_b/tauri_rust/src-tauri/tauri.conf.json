{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BAXY Tournament Rust",
  "version": "0.1.0",
  "identifier": "com.baxy.tournament.rust",
  "build": {
    "frontendDist": "../../shared_ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BAXY — asistente local",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
