+// K2's official tokenizer applies NFC before its byte-level pre-tokenizer.
+std::string unicode_utf8_normalize_nfc_windows(const std::string & text) {
+    if (text.empty()) {
+        return text;
+    }
+    const int wide_size = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), (int) text.size(), nullptr, 0);
+    if (wide_size <= 0) {
+        throw std::runtime_error("K2 NFC: invalid UTF-8");
+    }
+    std::wstring wide(wide_size, L'\0');
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), (int) text.size(), wide.data(), wide_size)) {
+        throw std::runtime_error("K2 NFC: UTF-16 conversion failed");
+    }
+    int normalized_size = NormalizeString(NormalizationC, wide.data(), wide_size, nullptr, 0);
+    if (normalized_size <= 0) {
+        throw std::runtime_error("K2 NFC: normalization sizing failed");
+    }
+    std::wstring normalized(normalized_size, L'\0');
+    normalized_size = NormalizeString(NormalizationC, wide.data(), wide_size, normalized.data(), normalized_size);
+    if (normalized_size <= 0) {
+        throw std::runtime_error("K2 NFC: normalization failed");
+    }
+    const int utf8_size = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, normalized.data(), normalized_size, nullptr, 0, nullptr, nullptr);
+    if (utf8_size <= 0) {
+        throw std::runtime_error("K2 NFC: UTF-8 sizing failed");
+    }
+    std::string result(utf8_size, '\0');
+    if (!WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, normalized.data(), normalized_size, result.data(), utf8_size, nullptr, nullptr)) {
+        throw std::runtime_error("K2 NFC: UTF-8 conversion failed");
+    }
+    return result;
+}
