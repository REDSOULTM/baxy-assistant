+    private static bool ContainsAnyWholeWord(string text, IReadOnlyList<string> tokens)
+    {
+        foreach (string token in tokens)
+        {
+            if (Regex.IsMatch(
+                text,
+                @"(?<![\p{L}\p{N}])" + Regex.Escape(token) + @"(?![\p{L}\p{N}])",
+                RegexOptions.CultureInvariant))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
