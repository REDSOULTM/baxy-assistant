+            Assert.That(decision.EffectOperations, Is.Empty);
+            Assert.That(MindClarificationPolicy.ShouldResumePendingObjective("37",
+                new MindTurnDecision("conversation", null, [], string.Empty, "Entendido.")), Is.True);
