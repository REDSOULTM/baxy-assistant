+_DEICTIC_WINDOW_MUTATION = re.compile(
+    r"^[¿?¡!\s]*(?:maximiza|maximizar|maximize|minimiza|minimizar|minimize|"
+    r"restaura|restaurar|restore)(?:me|la|lo)?\s+"
+    r"(?:"
