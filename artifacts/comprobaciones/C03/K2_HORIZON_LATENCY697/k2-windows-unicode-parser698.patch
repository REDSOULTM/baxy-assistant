+        return;
+    }
+    const std::vector<std::pair<std::string, std::string>> efforts = {
+        {"high", "ifm|think"}, {"medium", "ifm|think_fast"}, {"low", "ifm|think_faster"}
+    };
+    for (const auto & effort : efforts) {
+        for (const std::string format : {"plain", "xml", "json"}) {
+            t.test(effort.first + "/" + format, [&](testing & t) {
+                auto templates = common_chat_templates_init(nullptr, source);
+                common_chat_templates_inputs inputs;
+                inputs.messages = common_chat_msgs_parse_oaicompat(json::array({
+                    {{"role", "user"}, {"content", "Read the current audio volume."}}
+                }));
+                inputs.reasoning_format = COMMON_REASONING_FORMAT_DEEPSEEK;
+                inputs.enable_thinking = true;
+                inputs.chat_template_kwargs["reasoning_effort"] = json(effort.first).dump();
+                const std::string end = "</" + effort.second + ">";
+                std::string final = "4 GiB.";
+                if (format != "plain") {
+                    inputs.tools = {{"audio_status", "Read current audio volume.",
+                        R"({"type":"object","properties":{},"additionalProperties":false})"}};
+                    inputs.chat_template_kwargs["tool_call_format"] = json(format).dump();
+                    if (format == "json") {
+                        final = "<ifm|tool_calls>\n<ifm|tool_call>{\"name\":\"audio_status\",\"arguments\":{}}</ifm|tool_call>\n</ifm|tool_calls>";
+                    } else {
+                        final = "<ifm|tool_calls>\n<ifm|tool_call>audio_status\n</ifm|tool_call>\n</ifm|tool_calls>";
+                    }
+                }
+                auto generated = common_chat_templates_apply(templates.get(), inputs);
+                t.assert_equal("effective start", "<" + effort.second + ">", generated.thinking_start_tag);
+                t.assert_true("effective end", generated.thinking_end_tags == std::vector<std::string>{end});
+                common_chat_parser_params parser(generated);
+                parser.reasoning_format = COMMON_REASONING_FORMAT_DEEPSEEK;
+                parser.parser.load(generated.parser);
+                const std::string output = "check facts\n" + end + "\n" + final;
+                auto message = common_chat_parse(output, false, parser);
+                t.assert_equal("separated reasoning", "check facts", trim_whitespace(message.reasoning_content));
+                if (format == "plain") {
+                    t.assert_equal("clean final", "4 GiB.", trim_whitespace(message.content));
+                } else {
+                    t.assert_true("tool content empty", trim_whitespace(message.content).empty());
+                    if (t.assert_equal("one tool", size_t(1), message.tool_calls.size())) {
+                        t.assert_equal("tool name", "audio_status", message.tool_calls.front().name);
+                        t.assert_equal("tool arguments", "{}", json::parse(message.tool_calls.front().arguments).dump());
+                    }
+                }
+                for (size_t position : {size_t(5), size_t(12), output.find(end) + end.size() - 2,
+                                        output.find(end) + end.size()}) {
+                    auto partial = common_chat_parse(output.substr(0, position), true, parser);
+                    t.assert_true("reasoning prefix never visible", partial.content.empty());
+                }
+                // The official K2 parser keeps the selected effort delimiter.
+                // A tool opening can end reasoning implicitly, but a mismatched
+                // close must not expose arbitrary reasoning as visible prose.
+                for (const auto & emitted : efforts) {
+                    const std::string closing = "</" + emitted.second + ">";
+                    for (const std::string opening : {"", "<ifm|think>\n"}) {
+                        const std::string trace = opening + "check facts\n" + closing + "\n" + final;
+                        auto actual = common_chat_parse(trace, false, parser);
+                        t.assert_true("real trace reasoning retained",
+                                      actual.reasoning_content.find("check facts") != std::string::npos);
+                        if (format == "plain") {
+                            const bool matching = emitted.second == effort.second;
+                            t.assert_equal("selected effort controls prose", matching ? "4 GiB." : "",
+                                           trim_whitespace(actual.content));
+                            t.assert_true("mismatched close remains internal",
+                                          matching || actual.reasoning_content.find(final) != std::string::npos);
+                        } else if (t.assert_equal("mixed effort one tool", size_t(1), actual.tool_calls.size())) {
+                            t.assert_equal("mixed effort tool name", "audio_status", actual.tool_calls.front().name);
+                            t.assert_equal("mixed effort tool arguments", "{}", json::parse(actual.tool_calls.front().arguments).dump());
+                            t.assert_true("mixed effort tool content empty", trim_whitespace(actual.content).empty());
+                        }
+                        for (size_t position = 1; position <= trace.find(closing) + closing.size(); ++position) {
+                            auto partial = common_chat_parse(trace.substr(0, position), true, parser);
+                            t.assert_true("mixed effort stream does not leak", partial.content.empty());
+                            t.assert_true("mixed effort stream no premature tool", partial.tool_calls.empty());
+                        }
+                    }
+                }
+                if (format != "plain") {
+                    auto implicit = common_chat_parse("check facts\n" + final, false, parser);
+                    t.assert_equal("tool opens after unclosed reasoning", size_t(1), implicit.tool_calls.size());
+                    t.assert_equal("implicit close reasoning", "check facts", trim_whitespace(implicit.reasoning_content));
+                    t.assert_true("implicit close no visible reasoning", trim_whitespace(implicit.content).empty());
+                }
+            });
+        }
+    }
+}
