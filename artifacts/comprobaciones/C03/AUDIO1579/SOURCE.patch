+    private static string WithoutTrailingQuestion(string result)
+    {
+        string trimmed = result.TrimEnd();
+        if (!trimmed.EndsWith('?'))
+        {
+            return result;
+        }
+
+        int cut = trimmed.LastIndexOfAny(['.', '!', '?'], Math.Max(0, trimmed.Length - 2));
+        return cut < 0 ? string.Empty : trimmed[..(cut + 1)];
+    }
