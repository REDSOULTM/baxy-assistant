+        rf"(?:en|con|in|with|on)\s+(?:(?:el|la|the)\s+)?(?P<name>{_KNOWN_SOFTWARE})"
+        r"(?:\s*,?\s*(?:por\s+favor|please))?[\s.!?]*",
