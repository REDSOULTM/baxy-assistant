    {
      "path": "legacy/Carter_v2/audit/results/stability/_analyze.py",
      "queued_sha256": "e9d9b798cd497f3e48256b1f93785dc63cc38f6838f90ca758d7e577060db3a1",
      "size_queued": 2763,
      "exists": true,
      "disk_sha256": "e9d9b798cd497f3e48256b1f93785dc63cc38f6838f90ca758d7e577060db3a1",
      "disk_size": 2763,
      "hash_match": true,
      "head_sha256": "3b1c68df5d90f469b9a592399cff50b1b63edc6e5e3f1398edc19b76f8e74480",
      "head_error": null,
      "head_matches_queue": false,
      "outline": {
        "lines": 62,
        "bytes": 2763,
        "imports": [
          "1:import json, glob, os",
          "2:from collections import defaultdict"
        ],
        "defs": [],
        "head": [
          "import json, glob, os",
          "from collections import defaultdict",
          "",
          "runs = {}",
          "for f in sorted(glob.glob('audit/results/stability/run*.json')):",
          "    name = os.path.basename(f).replace('.json', '')",
          "    runs[name] = json.load(open(f, encoding='utf-8'))",
          "",
          "case_outcomes = defaultdict(dict)",
          "case_inputs = {}",
          "case_violations = defaultdict(dict)",
          "case_latencies = defaultdict(dict)",
          "for run, payload in runs.items():",
          "    for r in payload['records']:",
          "        cid = r['id']",
          "        case_inputs[cid] = r.get('input', '')",
          "        case_outcomes[cid][run] = r.get('outcome_class', '?')",
          "        case_violations[cid][run] = r.get('violations', [])",
          "        obs = r.get('observed') or {}",
          "        case_latencies[cid][run] = obs.get('latency_ms', 0) / 1000.0",
          "",
          "print('=== Run summaries ===')",
          "for run, p in runs.items():",
          "    print(f'  {run}: total={p.get(\"total\")} ok_succ={p.get(\"passed_successfully\")} honest={p.get(\"passed_honest_degraded\")} fail={p.get(\"failed\")}')",
          "",
          "qwen3_runs = [r for r in runs if 'qwen3_8b' in r]",
          "",
          "print('\\n=== Per-case outcomes across qwen3:8b runs ===')",
          "print(f'  {\"id\":>3} {\"input\":<40} ' + ' '.join(f'{r[3:25]:<22}' for r in qwen3_runs))",
          "for cid in sorted(case_outcomes):",
          "    cells = []",
          "    for run in qwen3_runs:",
          "        cls = case_outcomes[cid].get(run, '--')",
          "        viols = case_violations[cid].get(run, [])",
          "        short_viol = (viols[0][:18] + '..') if viols else ''",
          "        cells.append(f'{cls[:10]:<10}|{short_viol:<11}')",
          "    inp = (case_inputs[cid] or '')[:38]",
          "    print(f'  {cid:>3} {inp:<40} ' + ' '.join(f'{c:<22}' for c in cells))",
          "",
          "print('\\n=== Variance per case (qwen3:8b only) ===')"
        ]
      }
    },
    {
      "path": "legacy/Carter_v2/audit/results/stability/_analyze_rebaseline.py",
      "queued_sha256": "cedb571221559a1acaec6a5278f173d8005e4d58b58af2a42f774d932d33bd2b",
      "size_queued": 5059,
      "exists": true,
      "disk_sha256": "cedb571221559a1acaec6a5278f173d8005e4d58b58af2a42f774d932d33bd2b",
      "disk_size": 5059,
      "hash_match": true,
      "head_sha256": "6e0b58ebf362316b077713683aa08cd07543ca6aca946fb4d7b936eec15cd2a4",
      "head_error": null,
      "head_matches_queue": false,
      "outline": {
        "lines": 129,
        "bytes": 5059,
        "imports": [
          "9:import json, glob, os",
          "10:from collections import defaultdict"
        ],
        "defs": [
          "22:def jarvis_class(record):"
        ],
        "head": [
          "\"\"\"Rebaseline analyzer: computes semantic + budget-compliant scores and",
          "cross-model residual table across all qwen3:8b and qwen2.5:7b-instruct runs.",
          "",
          "Jarvis-grade budgets per case (independent of contract.max_total_seconds):",
          "- chat / no-op / simple reply (must_no_tools=True): 5s",
          "- single tool / single GUI / single vision: 8s",
          "- multi-step install (case 12: open + install): 16s",
          "\"\"\"",
          "import json, glob, os",
          "from collections import defaultdict",
          "",
          "JARVIS_BUDGETS = {",
          "    1: 5.0, 2: 5.0, 3: 8.0, 4: 8.0, 5: 8.0, 6: 8.0, 7: 8.0,",
          "    8: 8.0, 9: 5.0, 10: 5.0, 11: 5.0, 12: 16.0, 13: 5.0,",
          "}",
          "",
          "runs = {}",
          "for f in sorted(glob.glob('audit/results/stability/run*.json')):",
          "    name = os.path.basename(f).replace('.json', '')",
          "    runs[name] = json.load(open(f, encoding='utf-8'))",
          "",
          "def jarvis_class(record):",
          "    sem = record.get('outcome_class', 'fail')",
          "    lat = (record.get('observed') or {}).get('latency_ms', 0) / 1000.0",
          "    bud = JARVIS_BUDGETS.get(record['id'], 8.0)",
          "    if sem == 'fail':",
          "        return 'budget_fail', lat, bud",
          "    if lat > bud:",
          "        return 'budget_fail', lat, bud",
          "    if sem == 'pass_honest_degraded':",
          "        return 'budget_compliant_honest_degraded', lat, bud",
          "    return 'budget_compliant_successful', lat, bud",
          "",
          "# ---- summaries ----",
          "print('=== Run summaries (semantic + Jarvis-budget) ===')",
          "print(f'  {\"run\":<46} {\"sem S/H/F\":<12} {\"bud S/H/F\":<12}')",
          "for name, p in runs.items():",
