          "DEFAULT_PATH = Path(__file__).resolve().parent / \"data\" / \"historical_runtime_intents.jsonl\"",
          "_HASH = re.compile(r\"^[0-9a-f]{64}$\")",
          "_FAMILY = re.compile(r\"^[a-z][a-z0-9_]*$\")",
          "_EFFECTS = frozenset({\"none\", \"operation\", \"unsupported\"})",
          "",
