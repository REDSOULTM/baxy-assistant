        "head": [
          "\"\"\"Persistent mission journal for the Tool Ecosystem v2.",
          "",
          "The store is deliberately independent from the tool registry and contracts.",
          "Every public operation opens its own SQLite connection, applies the durability",
          "pragmas, and closes it after commit/rollback. Existing databases are never",
          "deleted, renamed, or silently rebuilt when validation fails.",
          "\"\"\"",
          "",
          "from __future__ import annotations",
          "",
          "import hashlib",
          "import hmac",
          "import json",
          "import math",
          "import os",
          "import re",
          "import secrets",
          "import shutil",
          "import sqlite3",
          "import time",
          "import unicodedata",
          "from contextlib import contextmanager",
          "from contextvars import ContextVar",
          "from dataclasses import dataclass, field as dataclass_field",
          "from datetime import datetime, timezone",
          "from pathlib import Path",
          "from types import MappingProxyType",
          "from typing import Any, Callable, Iterator, Mapping, Protocol, Sequence",
          "",
          "from .invocation_identity import (",
          "    InvocationBinding,",
          "    InvocationCompletionMode,",
          "    InvocationReceipt,",
          "    InvocationReservation,",
          ")",
          "from .secure_storage import SecureJsonCodec, SecureStorageError",
          "",
          "",
          "SCHEMA_VERSION = 8",
          "_EFFECT_CLAIM_SCHEMA_VERSION = 4"
        ]
      }
