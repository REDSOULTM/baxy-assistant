    def test_audio_projection_names_state_without_changing_raw_evidence(language, muted) -> None:
        from copy import deepcopy
    
        situation = {"kind": "operation", "operation": "audio.status",
                     "polarity": "success", "observed": {"state": {
                         "muted": muted, "volumePercent": 37}}}
        original = deepcopy(situation)
        payload = llm._compose_situation_payload(situation, language)
        assert payload["seen"] == {"muteState": "muted" if muted else "unmuted", "level": 37}
        assert situation == original
        faithful = "The speakers are muted." if muted else "The audio is unmuted."
        reversed_text = "The audio is unmuted." if muted else "The speakers are muted."
        # The existing validator still reads the provider's original boolean.
