  },
  "coveredBy": {"es": "la ventana «{window}» tapa la aplicación", "en": "the window «{window}» covers the application"},
  "placeNotFound": {"es": "no encontré {place} en esta ventana; puede que este equipo no lo tenga", "en": "I did not find {place} in this window; this computer may not have it"},
  "parts": {
   "source": "Live 2026-10-07 voice audit (cu-r16): a mission without a question is told from its facts first, part by part, not by the model: the places reached, the controls picked, the text typed or searched, a calculation whose value the window shows. Parts are the goals the mission reader writes, joined by «chain».",
   "chain": "; luego ",
   "select": "^seleccionar\\s+(?:el\\s+|la\\s+|los\\s+|las\\s+)?(.+)$",
   "type": "^escribir\\s+(.+)$",
   "search": "^buscar\\s+(.+)$",
   "calculate": "^calcular\\s+([0-9][0-9\\s.,()+*/×÷x-]*[0-9)])$",
   "key": "^apretar\\s+\\S.*$",
   "capsWord": 5,
   "operators": {"*": "×", "x": "×", "X": "×", "×": "×", "/": "÷", "÷": "÷", "+": "+", "-": "-"},
   "es": {"places": "pasé por {places}", "placesIn": "pasé por {places} en {app}", "lastPlace": "ya estoy en {place}", "lastPlaceIn": "ya estoy en {place} de {app}", "select": "elegí {items}", "shadeItem": "{chosen}, el {asked} de la paleta", "type": "escribí {texts} en {app}", "search": "busqué {query} en {app}", "calculate": "calculé {expression} = {value}", "calculateAlone": "Listo: {expression} = {value}", "clauses": "Listo, {clauses}"},
   "en": {"places": "I went through {places}", "placesIn": "I went through {places} in {app}", "lastPlace": "I'm now in {place}", "lastPlaceIn": "I'm now in {place} in {app}", "select": "I picked {items}", "shadeItem": "{chosen}, the {asked} of the palette", "type": "I typed {texts} in {app}", "search": "I searched for {query} in {app}", "calculate": "I worked out {expression} = {value}", "calculateAlone": "Done: {expression} = {value}", "clauses": "Done, {clauses}"}
  },
  "es": {"place": "Listo, estoy en {place}", "shade": "Listo, elegí {chosen}, el {asked} de la paleta", "app": "Listo, lo hice en {app}", "notPlace": "No pude llegar a {place}", "notApp": "No pude hacerlo en {app}", "not": "No pude hacerlo", "cause": "{head}: {cause}"},
  "en": {"place": "Done, I'm in {place}", "shade": "Done, I picked {chosen}, the {asked} of the palette", "app": "Done, I did it in {app}", "notPlace": "I couldn't get to {place}", "notApp": "I couldn't do it in {app}", "not": "I couldn't do it", "cause": "{head}: {cause}"}
