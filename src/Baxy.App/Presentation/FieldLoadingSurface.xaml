<UserControl x:Class="Baxy.App.Presentation.FieldLoadingSurface"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0E14">
  <Border Background="#0A0E14"
          BorderBrush="#B83A4A"
          BorderThickness="2"
          CornerRadius="6"
          Margin="10"
          AutomationProperties.AutomationId="FieldLoadingState"
          AutomationProperties.Name="Estado de carga de BAXY Field">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="BAXY · FIELD"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="17"
                 FontWeight="SemiBold"
                 Foreground="#D8DCE6"
                 HorizontalAlignment="Center" />
      <TextBlock x:Name="StatusText"
                 Margin="0,10,0,0"
                 Text="Recuperando la interfaz histórica local…"
                 AutomationProperties.LiveSetting="Polite"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="11"
                 Foreground="#8B95A8"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
