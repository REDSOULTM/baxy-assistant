   void DecodeStreams(OfflineStream **ss, int32_t n) const override {
+    // Select a decoder per utterance without reloading the shared NeMo model.
+    // A contextual stream must retain beam search; greedy cannot use its graph.
+    const auto effective_method = [this](OfflineStream *stream) {
+      const auto &requested = stream->GetOption("decoding_method");
+      return requested.empty() ? config_.decoding_method : requested;
+    };
+    const std::string method = effective_method(ss[0]);
+    bool mixed_methods = false;
+    for (int32_t i = 0; i != n; ++i) {
+      const std::string current = effective_method(ss[i]);
+      if (current != config_.decoding_method && current != "greedy_search") {
+        throw std::invalid_argument("Unsupported per-stream NeMo decoder");
+      }
+      if (current == "greedy_search" && ss[i]->GetContextGraph() != nullptr) {
+        throw std::invalid_argument("Greedy NeMo decoder cannot use hotwords");
+      }
+      mixed_methods = mixed_methods || current != method;
+    }
+    if (mixed_methods) {
+      // Keep each decoder's established batch behavior for homogeneous batches.
+      for (int32_t i = 0; i != n; ++i) {
+        DecodeStreams(ss + i, 1);
+      }
+      return;
+    }
     auto memory_info =
         Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeDefault);
 
