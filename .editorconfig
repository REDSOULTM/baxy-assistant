root = true

[*.cs]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 4
# Compiler warnings do not cover every unused private member shape.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

[tests/**/*.cs]
# NUnit names optimize for readable behavioral reports rather than public API shape.
dotnet_diagnostic.CA1707.severity = none
# Small literal arrays in tests are clearer inline and are not hot-path allocations.
dotnet_diagnostic.CA1861.severity = none
